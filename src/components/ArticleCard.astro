---
import { getOffer } from '../consts';
interface Props {
  href: string;
  title: string;
  description: string;
  pubDate: Date;
  niches?: string[];
}
const { href, title, description, pubDate, niches = [] } = Astro.props;
const primaryNiche = niches.length > 0 ? getOffer(niches[0]) : undefined;
const formattedDate = pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});
---
<a class="card" href={href}>
  <div class="card-top">
    {primaryNiche && <span class="tag">{primaryNiche.niche}</span>}
    <span class="date">{formattedDate}</span>
  </div>
  <h3>{title}</h3>
  <p class="desc">{description}</p>
  <span class="cta">Ler comparativo <span aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    text-decoration: none;
    color: var(--ink);
    box-shadow: var(--shadow-sm);
    height: 100%;
    position: relative;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--accent), var(--accent-lt));
    opacity: 0;
    transition: opacity 0.18s ease;
  }
  .card-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem;
    margin-bottom: 0.9rem;
  }
  .tag {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--brand-dk);
    background: var(--brand-wash);
    border-radius: 999px;
    padding: 0.25em 0.75em;
    white-space: nowrap;
  }
  .date {
    font-size: 0.76rem;
    color: var(--ink-mute);
    white-space: nowrap;
  }
  .card h3 { margin: 0 0 0.5rem; font-size: 1.15rem; }
  .desc { color: var(--ink-soft); font-size: 0.94rem; margin: 0; flex: 1; }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--accent-dk);
  }
  .cta span { transition: transform 0.18s ease; }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(240, 135, 44, 0.32);
  }
  .card:hover::before { opacity: 1; }
  .card:hover .cta span { transform: translateX(3px); }
</style>
