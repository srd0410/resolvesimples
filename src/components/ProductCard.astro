---
import type { Product } from '../consts';
import { slugifyProduct } from '../consts';
interface Props { product: Product; rank?: number }
const { product, rank } = Astro.props;
const isDeal = product.kind === 'deal';
const isOwn = product.own === true;
const id = slugifyProduct(product.name);
// Produto próprio é link interno e sem comissão de terceiro: não leva rel="sponsored"
// nem abre em nova aba.
const linkAttrs = isOwn
  ? {}
  : { target: '_blank', rel: 'sponsored noopener' };
---
<article id={id} class={`product${isDeal ? ' product-deal' : ''}${isOwn ? ' product-own' : ''}`}>
  <div class="product-head">
    <span class="badges">
      <span class={isOwn ? 'badge badge-own' : isDeal ? 'badge badge-deal' : 'badge badge-accent'}>
        {isOwn ? 'Produto nosso' : isDeal ? 'Oferta' : product.platform}
      </span>
      {rank && <span class="rank-badge">{rank}º</span>}
    </span>
    <span class="price">{product.price}</span>
  </div>

  <h3>{product.name}</h3>
  {product.rating && (
    <p class="rating">
      ★ {product.rating.toFixed(1).replace('.', ',')}
      {product.reviews && <span> · {product.reviews.toLocaleString('pt-BR')} avaliações</span>}
    </p>
  )}
  <p class="pitch">{product.pitch}</p>

  <p class={`take${isDeal ? ' take-deal' : ''}${isOwn ? ' take-own' : ''}`}>
    <strong>{isOwn ? 'Por que fizemos:' : isDeal ? 'Por que é só oferta:' : 'Por que indicamos:'}</strong> {product.take}
  </p>

  <a class="btn btn-primary" href={product.href} {...linkAttrs}>
    {isOwn ? `Conhecer o ${product.name}` : 'Ver oferta'}
  </a>

  {product.alt && (
    <a class="alt-link" href={product.alt.href} target="_blank" rel="sponsored noopener">
      {product.alt.label}
    </a>
  )}
</article>

<style>
  .product {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
    height: 100%;
  }
  .product-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .badges { display: flex; align-items: center; gap: 0.5rem; }
  .price {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15rem;
    color: var(--ink);
  }
  .product h3 { margin: 0 0 0.35rem; }
  .rating { font-size: 0.85rem; color: var(--brand-dk); margin: 0 0 0.6rem; }
  .rating span { color: var(--ink-soft); }
  .pitch { color: var(--ink-soft); font-size: 0.96rem; margin: 0 0 1rem; }
  .rank-badge {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.8rem;
    color: var(--ink-soft);
    background: var(--paper-2);
    border: 1px solid var(--line-2);
    border-radius: 999px;
    padding: 0.1rem 0.55rem;
  }
  .take {
    font-size: 0.9rem;
    color: var(--ink-soft);
    background: var(--paper-2);
    border-left: 3px solid var(--brand);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    padding: 0.8rem 1rem;
    margin: 0 0 1.4rem;
    flex: 1;
  }
  .take strong { color: var(--ink); }
  .product .btn { width: 100%; }

  /* Produto próprio: mesma estrutura do card de indicação, com destaque de borda
     e selo próprio para deixar claro que a relação comercial é outra. */
  .product-own {
    border-color: var(--brand);
    box-shadow: var(--shadow-md, var(--shadow-sm));
  }
  .badge-own {
    background: var(--brand);
    color: #fff;
    border: 1px solid var(--brand);
  }
  .take-own { border-left-color: var(--brand-dk, var(--brand)); }

  .product-deal { border-style: dashed; }
  .badge-deal {
    background: var(--paper-2);
    color: var(--ink-soft);
    border: 1px solid var(--line-2);
  }
  .take-deal { border-left-color: var(--line-2); }

  .alt-link {
    display: block;
    text-align: center;
    font-size: 0.85rem;
    color: var(--ink-soft);
    text-decoration: underline;
    margin-top: 0.6rem;
  }
  .alt-link:hover { color: var(--ink); }
</style>
