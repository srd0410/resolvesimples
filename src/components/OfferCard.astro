---
import type { Offer } from '../consts';
interface Props { offer: Offer }
const { offer } = Astro.props;
---
<a class="card" href={`/${offer.slug}/`}>
  <span class="icon" aria-hidden="true" set:html={offer.icon} />
  <p class="niche">{offer.niche}</p>
  <h3>{offer.title}</h3>
  <p class="pain">{offer.painPoint}</p>
  <span class="cta">Ver a seleção <span aria-hidden="true">&rarr;</span></span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    text-decoration: none;
    color: var(--ink);
    box-shadow: var(--shadow-sm);
    height: 100%;
    position: relative;
    overflow: hidden;
    transition: transform 0.18s ease, box-shadow 0.18s ease, border-color 0.18s ease;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 3px;
    background: linear-gradient(90deg, var(--brand), var(--brand-lt));
    opacity: 0;
    transition: opacity 0.18s ease;
  }

  .icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: var(--radius-sm);
    background: var(--paper-2);
    color: var(--ink-2);
    flex: none;
    margin-bottom: 1.15rem;
    transition: background 0.18s ease, color 0.18s ease;
  }
  .icon :global(svg) { width: 1.35rem; height: 1.35rem; }

  .niche {
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 0.45rem;
  }
  .card h3 { margin: 0 0 0.5rem; }
  .pain {
    color: var(--ink-soft);
    font-size: 0.96rem;
    margin: 0;
    flex: 1;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.25rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--brand-dk);
  }
  .cta span { transition: transform 0.18s ease; }

  .card:hover {
    transform: translateY(-3px);
    box-shadow: var(--shadow-md);
    border-color: rgba(13, 138, 99, 0.3);
  }
  .card:hover::before { opacity: 1; }
  .card:hover .icon { background: var(--brand-wash); color: var(--brand-dk); }
  .card:hover .cta span { transform: translateX(3px); }
</style>
