---
// Topo grafite das páginas de nicho, acervo e ranking, com banner fotográfico opcional.
// Celular e tablet: o título (slot padrão) fica SOBRE a base da foto, que desce para o
// grafite; trilha (slot "top") fica acima da foto e o texto de apoio + botão (slot
// "detail") logo abaixo. O assunto da foto fica entre 40% e 90% da largura (recorte 65%).
// Computador: foto atrás do topo, com degradê grafite à esquerda para o título.
// Sem imagem: o topo continua exatamente como era (sem foto).
// Banners em src/assets/banners/ (1920 × 800).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { image?: ImageMetadata; alt?: string; width?: string; }
const { image, alt = '', width = '48rem' } = Astro.props;
---
<section class:list={['hero', 'banner-hero', { 'has-banner': !!image }]} style={`--hero-w:${width}`}>
  <div class="hero-bg" aria-hidden="true"></div>
  <div class="wrap hero-top"><slot name="top" /></div>
  {image && (
    <div class="banner-media">
      <Image src={image} alt={alt} widths={[480, 800, 1200, 1920]} sizes="100vw" width={1920} height={800} format="webp" quality={78} loading="eager" decoding="async" />
    </div>
  )}
  <div class="wrap hero-inner">
    <div class="banner-title"><slot /></div>
    <div class="banner-detail"><slot name="detail" /></div>
  </div>
</section>
<style>
  .hero { position: relative; background: var(--command); color: #fff; padding: clamp(2.5rem, 5vw, 3.5rem) 0 clamp(3rem, 6vw, 4.5rem); overflow: hidden; isolation: isolate; }
  .hero-bg {
    position: absolute; inset: 0; z-index: -1;
    background:
      radial-gradient(ellipse 70% 55% at 12% 0%, rgba(13, 138, 99, 0.28), transparent 65%),
      radial-gradient(ellipse 55% 50% at 95% 15%, rgba(240, 135, 44, 0.20), transparent 62%),
      linear-gradient(180deg, var(--command-2) 0%, var(--command) 70%);
  }
  .hero-top:empty { display: none; }
  .hero-inner { max-width: var(--hero-w); position: relative; }
  .hero-top { max-width: var(--hero-w); }
  .banner-media { display: none; }

  .has-banner { display: grid; padding: 0; }
  .has-banner .hero-top { grid-row: 1; grid-column: 1; padding-block: 1.1rem .8rem; }
  .has-banner .banner-media { display: block; grid-row: 2; grid-column: 1; aspect-ratio: 1 / 1; background: var(--command); }
  .has-banner .banner-media :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 65% 50%; }
  .has-banner .hero-inner { display: contents; }
  .has-banner .banner-title {
    grid-row: 2; grid-column: 1; position: relative; z-index: 1; align-self: end;
    padding: 2.6rem max(1.25rem, calc((100% - 720px) / 2)) .5rem;
    background: linear-gradient(to top, var(--command) 0%, rgba(13, 16, 23, .93) 55%, rgba(13, 16, 23, 0) 100%);
  }
  .has-banner .banner-detail { grid-row: 3; grid-column: 1; padding: .2rem max(1.25rem, calc((100% - 720px) / 2)) 2rem; background: var(--command); }
  @media (min-width: 600px) {
    .has-banner .banner-media { aspect-ratio: 2 / 1; }
    .has-banner .banner-media :global(img) { object-position: 60% 50%; }
  }
  @media (min-width: 900px) {
    .has-banner { display: block; min-height: 380px; padding: clamp(2.5rem, 5vw, 3.5rem) 0 clamp(3rem, 6vw, 4.5rem); }
    .has-banner .hero-top { padding-block: 0; }
    .has-banner .banner-media { position: absolute; inset: 0; z-index: -1; aspect-ratio: auto; }
    .has-banner .banner-media :global(img) { object-position: center 50%; }
    .has-banner .banner-media::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--command) 0%, rgba(13, 16, 23, .92) 34%, rgba(13, 16, 23, .35) 58%, rgba(13, 16, 23, 0) 75%); }
    .has-banner .hero-inner { display: block; }
    .has-banner .banner-title, .has-banner .banner-detail { padding: 0; background: none; }
  }
</style>
