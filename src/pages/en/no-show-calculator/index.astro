---
// Landing/calculadora do VAGA Protocol em inglês — adaptação (não tradução
// literal) de /calculadora-agenda-vazia/. Fora do Layout.astro, mesma
// identidade visual da versão PT.
//
// Simplificação deliberada em relação à versão PT (ver INVENTARIO.md):
// SEM captura de e-mail / Brevo, porque ainda não existe formulário e
// automação em inglês configurados. A calculadora mostra o resultado
// inline (não depende de e-mail) e vai direto para os links de compra.
// Reavaliar quando houver infraestrutura de e-mail em inglês.
import { SITE } from '../../../consts';

const title = 'How much are no-shows costing your business? Free calculator';
const description = 'Work out in one minute how much no-shows and last-minute cancellations took out of your revenue over the last 30 days — and see how to fill the slot that opened up.';
const ogTitle = title;
const ogDescription = 'Enter your last 30 days and see the real size of the hole empty slots are opening in your revenue.';
const canonical = new URL('/en/no-show-calculator/', SITE.url).toString();
const ptAlternate = new URL('/calculadora-agenda-vazia/', SITE.url).toString();
const jsonLd = "{\n  \"@context\":\"https://schema.org\",\n  \"@graph\":[\n    {\n      \"@type\":\"WebApplication\",\n      \"name\":\"No-Show Cost Calculator\",\n      \"url\":\"https://www.resolvesimples.com.br/en/no-show-calculator/\",\n      \"applicationCategory\":\"BusinessApplication\",\n      \"operatingSystem\":\"Web\",\n      \"inLanguage\":\"en\",\n      \"description\":\"Calculates how much no-shows and last-minute cancellations cost a business over the last 30 days, from numbers entered by the user.\",\n      \"offers\":{\"@type\":\"Offer\",\"price\":\"0\",\"priceCurrency\":\"USD\"},\n      \"publisher\":{\"@type\":\"Organization\",\"name\":\"Resolve Simples\",\"url\":\"https://www.resolvesimples.com.br/\"}\n    },\n    {\n      \"@type\":\"FAQPage\",\n      \"mainEntity\":[\n        {\"@type\":\"Question\",\"name\":\"How do I calculate how much I'm losing to no-shows?\",\n         \"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Add up last-minute cancellations and no-shows over the past 30 days, subtract the slots you managed to refill with someone else, and multiply the result by your average ticket per appointment. That's the revenue that never came in that month. Multiply by 12 for the yearly projection.\"}},\n        {\"@type\":\"Question\",\"name\":\"Can I charge a cancellation fee to a client who no-showed?\",\n         \"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"In most places, a cancellation fee is only enforceable if it was clearly disclosed and agreed to before booking. A surprise charge applied only after the fact tends to be disputed and can hurt your reputation. In practice, many businesses get better results offering a small discount for prepayment than penalizing people who no-show. This is general information, not legal advice for your jurisdiction.\"}},\n        {\"@type\":\"Question\",\"name\":\"What's the best appointment confirmation message?\",\n         \"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"One that asks for an active reply instead of just reminding. A message that only states the date gets little response; a message that asks for a short confirmation creates a small commitment and reveals earlier who isn't going to show up, which gives you time to offer the slot to someone else.\"}},\n        {\"@type\":\"Question\",\"name\":\"How do I fill a slot that opened up at the last minute?\",\n         \"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"With a waitlist organized before the slot opens, sorted by service and by who's available on short notice. When a cancellation comes in, you offer the slot to someone who already showed interest in that specific service, instead of posting to everyone and waiting.\"}},\n        {\"@type\":\"Question\",\"name\":\"What's a normal no-show rate for salons and clinics?\",\n         \"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"There's no single reliable published average across salons, barbershops and aesthetic clinics worldwide. The strongest data comes from healthcare: a review of 105 studies published in Health Policy found an average no-show rate of 23%, with large variation between countries and specialties. Treat it as an order of magnitude, not a benchmark for your specific business.\"}},\n        {\"@type\":\"Question\",\"name\":\"Do I need paid software to reduce no-shows?\",\n         \"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. The essentials — active confirmation, a clear policy, an organized waitlist and a simple log of what happened — run on a messaging app and a spreadsheet. Paid software speeds things up, but it isn't what makes the initial difference.\"}}\n      ]\n    }\n    ,{\n      \"@type\":\"Product\",\n      \"name\":\"VAGA Protocol\",\n      \"description\":\"A complete system to reduce no-shows and last-minute cancellations and refill open slots in appointment-based businesses, with tracking sheets, a message bank, editable documents and a rollout plan.\",\n      \"brand\":{\"@type\":\"Brand\",\"name\":\"Resolve Simples\"},\n      \"offers\":{\n        \"@type\":\"Offer\",\n        \"price\":\"18.00\",\n        \"priceCurrency\":\"USD\",\n        \"availability\":\"https://schema.org/InStock\",\n        \"url\":\"https://www.resolvesimples.com.br/en/no-show-calculator/#offer\"\n      }\n    }\n  ]\n}";
---
<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<link rel="alternate" hreflang="en" href={canonical} />
<link rel="alternate" hreflang="pt-BR" href={ptAlternate} />
<link rel="alternate" hreflang="x-default" href={ptAlternate} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<meta property="og:type" content="website" />
<meta property="og:locale" content="en_US" />
<meta property="og:site_name" content="VAGA Protocol" />
<meta property="og:title" content={ogTitle} />
<meta property="og:description" content={ogDescription} />
<meta property="og:url" content={canonical} />
<meta name="twitter:card" content="summary_large_image" />
<meta name="robots" content="index,follow,max-snippet:-1,max-image-preview:large" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

<script type="application/ld+json" is:inline set:html={jsonLd} />

{SITE.gaMeasurementId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}></script>}
{SITE.gaMeasurementId && (
  <script is:inline define:vars={{ gaMeasurementId: SITE.gaMeasurementId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', gaMeasurementId);
  </script>
)}

<style is:global set:html={`
:root{
    --ink:#0D1B2A; --ink-soft:#2B3B4A; --ink-faint:#5A6B7C;
    --paper:#F2F4F7; --paper-raised:#FFFFFF; --line:#DDE3EA;
    --lost:#B0214E; --lost-wash:#FBEAF0;
    --kept:#00A78E; --kept-wash:#E5F7F3; --idle:#E7EBF0;
    --blue:#1565C0; --blue-wash:#EAF2FC;
    --radius:14px; --maxw:640px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  body{
    background:var(--paper);color:var(--ink);
    font-family:"Poppins",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased;padding:0 20px 80px;
  }
  .wrap{max-width:var(--maxw);margin:0 auto}

  .masthead{padding:26px 0 0;display:flex;align-items:center;gap:9px}
  .mark{width:9px;height:9px;background:var(--lost);border-radius:2px;transform:rotate(45deg)}
  .brand{font-family:"IBM Plex Mono",monospace;font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-soft);text-decoration:none}

  .hero{padding:42px 0 28px}
  .eyebrow{font-family:"IBM Plex Mono",monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--lost);margin-bottom:18px}
  h1{font-family:"Poppins",sans-serif;font-weight:800;font-size:clamp(33px,8.4vw,50px);line-height:1.02;letter-spacing:-.028em;margin-bottom:20px}
  h1 .hollow{color:var(--lost)}
  .deck{font-size:18px;color:var(--ink-soft);max-width:32em}

  h2{font-family:"Poppins",sans-serif;font-weight:700;font-size:clamp(24px,6vw,30px);line-height:1.15;letter-spacing:-.022em;margin:44px 0 14px}
  h3{font-family:"Poppins",sans-serif;font-weight:700;font-size:19px;letter-spacing:-.015em;margin:26px 0 8px}
  .prose p{margin-bottom:16px;color:var(--ink-soft)}
  .prose strong{color:var(--ink)}
  .prose ul{margin:0 0 18px;padding-left:0;list-style:none}
  .prose ul li{position:relative;padding-left:24px;margin-bottom:9px;color:var(--ink-soft)}
  .prose ul li::before{content:"";position:absolute;left:3px;top:10px;width:7px;height:7px;background:var(--lost);border-radius:2px;transform:rotate(45deg)}

  /* agenda */
  .agenda{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius);padding:20px 18px 18px;margin:30px 0 8px}
  .agenda-head{display:flex;justify-content:space-between;align-items:baseline;margin-bottom:16px;gap:12px}
  .agenda-title{font-family:"IBM Plex Mono",monospace;font-size:11.5px;letter-spacing:.11em;text-transform:uppercase;color:var(--ink-faint)}
  .agenda-count{font-family:"IBM Plex Mono",monospace;font-size:12.5px;font-weight:600;color:var(--lost);white-space:nowrap}
  .agenda-count.idle{color:var(--ink-faint)}
  .slots{display:grid;grid-template-columns:repeat(auto-fill,minmax(30px,1fr));gap:5px}
  .slot{aspect-ratio:1/1.28;border-radius:4px;background:var(--kept-wash);border:1px solid #BFE6DD;transition:background .28s ease,border-color .28s ease,transform .28s ease}
  .slot.lost{background:var(--lost-wash);border:1px dashed var(--lost);background-image:repeating-linear-gradient(45deg,transparent 0 3px,rgba(176,33,78,.26) 3px 4px);transform:scale(.9)}
  .slot.idle{background:var(--idle);border:1px solid var(--line)}
  .legend{display:flex;gap:18px;margin-top:15px;font-size:13px;color:var(--ink-soft);flex-wrap:wrap}
  .legend span{display:flex;align-items:center;gap:7px}
  .chip{width:12px;height:12px;border-radius:3px;flex:none}
  .chip.kept{background:var(--kept-wash);border:1px solid #BFE6DD}
  .chip.lost{background:var(--lost-wash);border:1px dashed var(--lost)}

  /* painéis */
  .panel{background:var(--paper-raised);border:1px solid var(--line);border-radius:var(--radius);padding:24px 20px;margin-top:26px}
  .panel-title{font-family:"Poppins",sans-serif;font-weight:700;font-size:21px;letter-spacing:-.015em;margin-bottom:4px}
  .panel-sub{font-size:15px;color:var(--ink-soft);margin-bottom:24px}
  .field{margin-bottom:26px}
  .field:last-child{margin-bottom:0}
  .field-top{display:flex;justify-content:space-between;align-items:flex-start;gap:14px;margin-bottom:10px}
  label{display:block;font-size:15.5px;font-weight:500;line-height:1.3}
  .hint{display:block;font-size:13px;font-weight:400;color:var(--ink-faint);margin-top:3px}

  .readout{display:flex;align-items:center;flex:none;background:var(--paper);border:1.5px solid var(--line);border-radius:8px;padding:5px 9px;gap:3px;font-family:"IBM Plex Mono",monospace;font-size:15px;font-weight:600;color:var(--ink);transition:border-color .18s ease,background .18s ease}
  .readout.set{border-color:var(--ink)}
  .readout:focus-within{border-color:var(--ink);background:var(--paper-raised)}
  .readout .unit{color:var(--ink-faint);font-size:13px;font-weight:500}
  .readout input{width:4.2ch;border:none;background:transparent;padding:0;margin:0;font-family:inherit;font-size:15px;font-weight:600;color:inherit;text-align:right;-moz-appearance:textfield}
  .readout input.w5{width:5.4ch}
  .readout input::-webkit-outer-spin-button,.readout input::-webkit-inner-spin-button{-webkit-appearance:none;margin:0}
  .readout input:focus{outline:none}
  .readout input::placeholder{color:var(--ink-faint);font-weight:500}

  input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:32px;background:transparent;cursor:pointer;display:block}
  input[type=range]::-webkit-slider-runnable-track{height:5px;background:var(--line);border-radius:99px}
  input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:28px;height:28px;margin-top:-11.5px;border-radius:50%;background:var(--ink);border:4px solid var(--paper-raised);box-shadow:0 1px 5px rgba(32,26,46,.32)}
  input[type=range]::-moz-range-track{height:5px;background:var(--line);border-radius:99px}
  input[type=range]::-moz-range-thumb{width:20px;height:20px;border-radius:50%;background:var(--ink);border:4px solid var(--paper-raised);box-shadow:0 1px 5px rgba(32,26,46,.32)}
  input[type=range].untouched::-webkit-slider-thumb{background:#AFBCC8;box-shadow:none}
  input[type=range].untouched::-moz-range-thumb{background:#AFBCC8;box-shadow:none}
  input[type=range]:focus-visible::-webkit-slider-thumb{outline:3px solid var(--lost);outline-offset:2px}
  input[type=range]:focus-visible::-moz-range-thumb{outline:3px solid var(--lost);outline-offset:2px}

  .err{display:none;font-size:13.5px;color:var(--lost);margin-top:8px;font-weight:500}
  .err.show{display:block}

  .result{background:var(--ink);color:var(--paper);border-radius:var(--radius);padding:30px 22px 26px;margin-top:26px}
  .result-label{font-family:"IBM Plex Mono",monospace;font-size:11.5px;letter-spacing:.13em;text-transform:uppercase;color:#B9C4CF;margin-bottom:10px}
  .big{font-family:"Poppins",sans-serif;font-weight:800;font-size:clamp(42px,13vw,68px);line-height:.95;letter-spacing:-.035em;color:#FF8FB2;margin-bottom:6px;word-break:break-word}
  .big.idle{color:#7E8FA0}
  .big-note{font-size:15px;color:#B9C4CF}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:24px;padding-top:22px;border-top:1px solid #22364A}
  .stat-k{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#B9C4CF;margin-bottom:5px;line-height:1.3}
  .stat-v{font-family:"Poppins",sans-serif;font-weight:700;font-size:23px;letter-spacing:-.02em}

  .bridge{margin-top:30px}
  .bridge h2{margin-top:0}

  .personas{margin-top:34px}
  .personas h2{margin-top:0;margin-bottom:6px}
  .personas .lede{font-size:16px;color:var(--ink-soft);margin-bottom:20px}
  .persona-list{display:flex;flex-direction:column;gap:14px}
  .persona{background:var(--paper-raised);border:1px solid var(--line);border-left:4px solid var(--lost);border-radius:10px;padding:16px 18px}
  .persona .quem{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--lost);margin-bottom:6px;font-weight:600}
  .persona p:last-child{margin:0;font-size:15.5px;line-height:1.55;color:var(--ink-soft)}

  .final-push{background:var(--ink);color:var(--paper);border-radius:var(--radius);padding:32px 22px 28px;margin-top:44px;text-align:center}
  .final-push h2{color:#FFFFFF;margin-top:0;font-size:clamp(22px,6vw,27px)}
  .final-push p{color:#B9C4CF;max-width:30em;margin:0 auto 22px;font-size:15.5px;line-height:1.6}
  .final-push .btn{display:inline-block;background:var(--kept);color:#FFFFFF;text-decoration:none;font-family:"Poppins",sans-serif;font-weight:700;font-size:17px;padding:16px 26px;border-radius:9px;transition:background .18s ease,transform .12s ease}
  .final-push .btn:hover{background:#00C0A2}
  .final-push .btn:active{transform:translateY(1px)}

  /* FAQ */
  details{border-bottom:1px solid var(--line);padding:16px 0}
  details:first-of-type{border-top:1px solid var(--line)}
  summary{
    font-family:"Poppins",sans-serif;font-weight:700;font-size:17.5px;
    letter-spacing:-.012em;cursor:pointer;list-style:none;
    display:flex;justify-content:space-between;align-items:flex-start;gap:14px;
  }
  summary::-webkit-details-marker{display:none}
  summary::after{content:"+";font-family:"IBM Plex Mono",monospace;font-weight:400;font-size:21px;color:var(--lost);line-height:1;flex:none}
  details[open] summary::after{content:"–"}
  summary:focus-visible{outline:2px solid var(--ink);outline-offset:3px;border-radius:4px}
  details p{margin-top:11px;color:var(--ink-soft);font-size:16px}

  .backlink{display:inline-block;margin-top:8px;font-weight:600;color:var(--lost);text-decoration:none;border-bottom:1.5px solid currentColor}

  .sources{margin-top:38px;padding-top:22px;border-top:1px solid var(--line);font-size:13.5px;color:var(--ink-faint);line-height:1.6}
  .sources strong{display:block;font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--ink-soft);margin-bottom:9px;font-weight:600}
  .sources a{color:var(--ink-soft)}

  /* ---------- offer ---------- */
  .oferta{
    background:var(--ink);color:var(--paper);
    border-radius:var(--radius);padding:30px 22px 26px;margin-top:26px;
  }
  .oferta .selo{
    font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.13em;
    text-transform:uppercase;color:var(--kept);margin-bottom:12px;font-weight:600;
  }
  .oferta h2{
    font-family:"Poppins",sans-serif;font-weight:800;
    font-size:clamp(25px,6.6vw,32px);line-height:1.12;letter-spacing:-.02em;
    color:#FFFFFF;margin:0 0 14px;
  }
  .oferta .lead{font-size:16px;line-height:1.6;color:#B9C4CF;margin:0 0 22px}
  .oferta .lead strong{color:#FFFFFF}
  .oferta ul{list-style:none;margin:0 0 22px;padding:0}
  .oferta li{
    position:relative;padding-left:24px;margin-bottom:11px;
    font-size:15.5px;line-height:1.55;color:#D6DEE6;
  }
  .oferta li::before{
    content:"";position:absolute;left:0;top:8px;width:9px;height:9px;
    background:var(--kept);border-radius:2px;
  }
  .oferta li b{color:#FFFFFF;font-weight:600}
  .oferta .preco{border-top:1px solid #22364A;padding-top:22px}
  .oferta .de{
    font-family:"IBM Plex Mono",monospace;font-size:12px;letter-spacing:.1em;
    text-transform:uppercase;color:#B9C4CF;margin-bottom:6px;
  }
  .oferta .valor{
    font-family:"Poppins",sans-serif;font-weight:800;
    font-size:clamp(38px,11vw,52px);line-height:1;letter-spacing:-.03em;
    color:#FFFFFF;margin-bottom:6px;
  }
  .oferta .cond{font-size:14.5px;color:#B9C4CF;margin-bottom:22px}
  .oferta .btn{
    display:block;width:100%;box-sizing:border-box;text-align:center;
    background:var(--kept);color:#FFFFFF;text-decoration:none;
    font-family:"Poppins",sans-serif;font-weight:700;font-size:17.5px;
    padding:18px;border-radius:9px;
    transition:background .18s ease,transform .12s ease;
  }
  .oferta .btn:hover{background:#00C0A2}
  .oferta .btn:active{transform:translateY(1px)}
  .oferta .btn:focus-visible{outline:3px solid #FFFFFF;outline-offset:3px}
  .oferta .garantia{
    display:flex;gap:12px;align-items:flex-start;
    margin-top:20px;padding-top:20px;border-top:1px solid #22364A;
  }
  .oferta .garantia .marca{
    flex:none;width:34px;height:34px;border-radius:8px;background:#12324A;
    color:var(--kept);font-family:"Poppins",sans-serif;font-weight:800;font-size:15px;
    display:flex;align-items:center;justify-content:center;
  }
  .oferta .garantia p{margin:0;font-size:14.5px;line-height:1.55;color:#B9C4CF}
  .oferta .garantia strong{color:#FFFFFF}
  .oferta .ps{margin:18px 0 0;font-size:13.5px;line-height:1.55;color:#8FA0B0}

  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}html{scroll-behavior:auto}}
`}></style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    <div class="mark" aria-hidden="true"></div>
    <a class="brand" href="/en/">VAGA Protocol</a>
  </header>

  <main>
  <article>

  <section class="hero">
    <div class="eyebrow">VAGA Protocol · $18</div>
    <h1>Every empty slot <span class="hollow">doesn't sit on a shelf. It's just gone.</span></h1>
    <p class="deck">You don't sell a product, you sell booked time. When someone no-shows and nobody takes that slot, the hour doesn't wait around to be sold later — it simply stopped existing, while rent, staff and utilities got paid the same either way. In one minute you'll see the exact size of that hole in your own numbers. This applies whether you own the business or you're the one running the calendar day to day.</p>
    <p><a class="backlink" href="https://pay.kiwify.com.br/qkgpS7Q">I already know I want it → get VAGA Protocol now</a></p>
  </section>

  <section class="agenda" aria-labelledby="agenda-title" id="calculator">
    <div class="agenda-head">
      <div class="agenda-title" id="agenda-title">Your last 30 days</div>
      <div class="agenda-count idle" id="agendaCount">drag to get started</div>
    </div>
    <div class="slots" id="slots" role="img" aria-label="Grid of appointment slots for the period. No data entered yet."></div>
    <div class="legend">
      <span><i class="chip kept" aria-hidden="true"></i> Slot that paid off</span>
      <span><i class="chip lost" aria-hidden="true"></i> Slot that stayed empty</span>
    </div>
  </section>

  <section class="panel">
    <div class="panel-title">Your business, in numbers</div>
    <div class="panel-sub">Last 30 days, all staff combined. Drag to get close — or tap the number to type it in.</div>

    <div class="field">
      <div class="field-top">
        <label for="ticket">What you make, on average, per appointment<span class="hint">Add up what came in and divide by number of appointments</span></label>
        <div class="readout" id="boxTicket"><span class="unit">$</span><input type="number" id="numTicket" class="w5" min="1" max="20000" step="1" inputmode="numeric" placeholder="—" aria-label="Average ticket in dollars"></div>
      </div>
      <input type="range" id="ticket" class="untouched" min="20" max="1200" step="10" value="20" aria-label="Adjust average ticket">
    </div>

    <div class="field">
      <div class="field-top">
        <label for="agendados">Appointments booked in the last 30 days<span class="hint">Everything on the calendar, whether it happened or not</span></label>
        <div class="readout" id="boxAgendados"><input type="number" id="numAgendados" min="1" max="5000" step="1" inputmode="numeric" placeholder="—" aria-label="Appointments booked"></div>
      </div>
