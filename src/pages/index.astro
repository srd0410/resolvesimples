---
import Layout from '../layouts/Layout.astro';
import OfferCard from '../components/OfferCard.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';
import { OFFERS, getAllProducts } from '../consts';

const allArticles = (await getCollection('artigos', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latestArticles = allArticles.slice(0, 3);
const articlesCount = allArticles.length;

const picksCount = getAllProducts().filter((p) => p.kind !== 'deal').length;
const areasCount = OFFERS.length;

const criteria = [
  {
    title: 'Resolve um problema sério',
    body: 'A dor precisa ser real, recorrente e custar dinheiro de verdade — não um incômodo qualquer.',
  },
  {
    title: 'Aplicação simples',
    body: 'Preferimos ferramenta pronta a curso longo. Se leva meses para aplicar, não entra aqui.',
  },
  {
    title: 'Diferença perceptível',
    body: 'O resultado precisa aparecer no caixa ou na rotina em pouco tempo, de forma mensurável.',
  },
  {
    title: 'Preço proporcional',
    body: 'O custo tem que ser pequeno perto do que o problema já está tirando do seu bolso.',
  },
];

const steps = [
  {
    n: '01',
    title: 'Mapeamos a dor',
    body: 'Escolhemos um problema específico de um setor e levantamos quanto ele custa, em números.',
  },
  {
    n: '02',
    title: 'Filtramos a solução',
    body: 'Avaliamos o que existe no mercado e descartamos o que é genérico, caro demais ou difícil de aplicar.',
  },
  {
    n: '03',
    title: 'Explicamos direto',
    body: 'Montamos uma página curta: o problema, a conta, a solução e o caminho para aplicar. Sem enrolação.',
  },
];
---
<Layout
  title="Pare de perder dinheiro com horário vago na agenda"
  description="Salão, clínica e barbearia perdem receita toda vez que alguém falta e ninguém entra no lugar. Conheça o Protocolo VAGA, o sistema para reduzir faltas e reocupar o horário que vagou — e faça o diagnóstico gratuito da sua agenda."
  hreflangEn="/en/"
>
  <!-- ================= HERO ================= -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <p class="eyebrow eyebrow-on-dark">Salão · clínica · barbearia · quem vive de agenda</p>

        <h1>
          O horário que vagou e ninguém preencheu
          <span class="hl">não volta mais.</span>
        </h1>

        <p class="hero-lede">
          Você não vende produto, vende tempo marcado. Quando alguém falta e ninguém entra no
          lugar, aquela hora não fica na prateleira esperando — ela deixou de existir, com o
          aluguel, a luz e a profissional já pagos do mesmo jeito.
          <strong>Move os três controles ao lado e veja o tamanho disso no seu caso.</strong>
        </p>

      </div>

      <!-- Mini-diagnóstico: mesma conta da calculadora completa, com três
           controles em vez de seis. Serve de gancho e leva os números adiante. -->
      <div class="hero-calc">
        <p class="hc-titulo">Quanto a sua agenda vaza por ano?</p>

        <div class="hc-campo">
          <label for="hcAgendados">Atendimentos marcados por mês <output id="hcOutAgendados">60</output></label>
          <input type="range" id="hcAgendados" min="10" max="300" step="1" value="60" />
        </div>

        <div class="hc-campo">
          <label for="hcFaltas">Faltas e desmarcações por mês <output id="hcOutFaltas">6</output></label>
          <input type="range" id="hcFaltas" min="0" max="60" step="1" value="6" />
        </div>

        <div class="hc-campo">
          <label for="hcTicket">Valor médio do atendimento <output id="hcOutTicket">R$ 120</output></label>
          <input type="range" id="hcTicket" min="20" max="500" step="5" value="120" />
        </div>

        <div class="hc-saida">
          <p class="hc-rotulo">Receita que não entra por ano</p>
          <p class="hc-valor" id="hcValor">R$ 8.640</p>
          <p class="hc-nota" id="hcNota">Antes de descontar o que você consegue reocupar.</p>
        </div>

        <a class="btn btn-primary btn-lg hc-btn" id="hcCta" href="/calculadora-agenda-vazia/#calculadora">
          Ver meu diagnóstico completo
        </a>
        <p class="hc-ps">Gratuito. Na página seguinte você ajusta quantos horários consegue preencher e vê o número real.</p>
      </div>

      <ul class="trust">
        <li><span class="tick" aria-hidden="true">✓</span> Usa os seus números, não uma média inventada</li>
        <li><span class="tick" aria-hidden="true">✓</span> Sem cadastro para ver o resultado</li>
        <li><span class="tick" aria-hidden="true">✓</span> Leva menos de um minuto</li>
      </ul>
    </div>
  </section>

  <!-- ================= PRODUTO PRÓPRIO EM DESTAQUE ================= -->
  <section class="flagship">
    <div class="wrap flagship-inner">
      <div class="flagship-copy">
        <p class="eyebrow flagship-eyebrow">Produto nosso · não é indicação de terceiro</p>
        <h2 class="flagship-title">
          Toda falta que ninguém repõe
          <span class="hl">vira dinheiro que some do seu caixa.</span>
        </h2>
        <p class="flagship-lede">
          Criamos o <strong>Protocolo VAGA</strong>: o sistema que reduz as faltas e desmarcações
          de última hora em negócios de agenda — estética, salão, barbearia, clínica — e ensina a
          preencher o horário que vagou antes que ele vire prejuízo. Por <strong>R$ 47</strong>,
          uma única vaga recuperada nesse valor já compensa o investimento.
        </p>
        <div class="flagship-cta">
          <a href="/calculadora-agenda-vazia/#calculadora" class="btn btn-primary btn-lg" data-calc-link>Calcular quanto eu perco</a>
          <a href="/calculadora-agenda-vazia/#protocolo-vaga" class="btn btn-ghost-dark btn-lg">Já sei que quero, ver o Protocolo VAGA</a>
          <a href="/en/" class="btn btn-ghost-dark btn-lg" lang="en" hreflang="en">View in English</a>
        </div>
      </div>
      <div class="flagship-media">
        <img
          src="/images/vaga/mockup-protocolo-vaga.png"
          alt="Protocolo VAGA — planilhas, mensagens prontas e guia de implantação, mostrados em notebook, celular e material impresso"
          width="1600"
          height="1200"
          loading="eager"
        />
      </div>
    </div>
  </section>

  <!-- ================= DIVISOR: O RESTO DO PORTAL ================= -->
  <section class="section portal-intro">
    <div class="wrap-narrow">
      <p class="eyebrow">Além do Protocolo VAGA</p>
      <h2>A Resolve Simples também compara o que resolve problema pequeno e caro.</h2>
      <p class="lede">
        A mesma lógica da conta que você acabou de fazer vale para outras áreas: achar o
        gasto que passa despercebido, mostrar quanto ele custa por ano e apontar a solução
        mais simples. Abaixo está o resto do que publicamos — de eletrônicos a organização
        de casa. <strong>Quando a indicação é de afiliado, está sempre sinalizada.</strong>
      </p>
    </div>
  </section>

  <!-- ================= BARRA DE NÚMEROS ================= -->
  <section class="stats-bar" aria-label="Números do portal">
    <div class="wrap stats-inner">
      <div class="stat">
        <strong>{articlesCount}</strong>
        <span>comparativo{articlesCount === 1 ? '' : 's'} publicado{articlesCount === 1 ? '' : 's'}</span>
      </div>
      <div class="stat">
        <strong>{picksCount}</strong>
        <span>produto{picksCount === 1 ? '' : 's'} indicado{picksCount === 1 ? '' : 's'}</span>
      </div>
      <div class="stat">
        <strong>{areasCount}</strong>
        <span>área{areasCount === 1 ? '' : 's'} cobertas</span>
      </div>
    </div>
  </section>

  <!-- ================= COMECE PELOS COMPARATIVOS ================= -->
  {latestArticles.length > 0 && (
    <section class="section section-tint" aria-label="Comparativos em destaque">
      <div class="wrap">
        <div class="section-head">
          <p class="eyebrow">Comparativos</p>
          <h2>Leia o comparativo antes de decidir.</h2>
          <p class="lede">
            Cada indicação do site vem de um comparativo publicado antes — o produto,
            o motivo e o link ficam sempre no mesmo lugar.
          </p>
        </div>

        <div class="articles-grid">
          {latestArticles.map((post) => (
            <ArticleCard
              href={`/artigos/${post.slug}/`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              niches={post.data.niches}
            />
          ))}
        </div>

        <a href="/artigos/" class="see-all-articles">Ver todos os comparativos &rarr;</a>
      </div>
    </section>
  )}

  <!-- ================= ÁREAS ================= -->
  <section id="areas" class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Áreas que cobrimos</p>
        <h2>Cada área tem sua própria página.</h2>
        <p class="lede">
          Um problema por vez, com a conta feita e a solução explicada. Escolha a área
          que tem a ver com o seu caso.
        </p>
      </div>

      <div class="offers-grid">
        {OFFERS.map((offer) => <OfferCard offer={offer} />)}
      </div>
    </div>
  </section>

  <!-- ================= CRITÉRIOS ================= -->
  <section id="criterios" class="section section-tint">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Nossos critérios</p>
        <h2>O que precisa ser verdade para uma solução entrar aqui.</h2>
        <p class="lede">
          A maior parte do que existe no mercado não passa nesse filtro. É por isso que
          cada área tem poucas indicações — e não uma lista infinita.
        </p>
      </div>

      <div class="criteria-grid">
        {criteria.map((c, i) => (
          <div class="criterion">
            <span class="criterion-n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{c.title}</h3>
            <p>{c.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= COMO FUNCIONA ================= -->
  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">Como funciona</p>
        <h2>Três etapas, sempre na mesma ordem.</h2>
      </div>

      <div class="steps">
        {steps.map((s) => (
          <div class="step">
            <span class="step-n">{s.n}</span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ================= CTA FINAL ================= -->
  <section class="final-cta">
    <div class="wrap-narrow final-inner">
      <h2>A agenda não avisa quando começa a vazar.</h2>
      <p>
        Ela só aparece no fim do mês, num faturamento que não bate com o esforço. Faça a
        conta com os seus números — o diagnóstico é gratuito e leva menos de um minuto.
      </p>
      <div class="final-cta-botoes">
        <a href="/calculadora-agenda-vazia/#calculadora" class="btn btn-primary btn-lg" data-calc-link>Calcular a minha perda</a>
        <a href="/calculadora-agenda-vazia/#protocolo-vaga" class="btn btn-ghost-dark btn-lg">Ver o Protocolo VAGA · R$ 47</a>
      </div>
      <p class="final-ps">
        Tem outro problema custando caro no seu negócio?
        <a href="mailto:contato@resolvesimples.com.br?subject=Sugestão%20de%20problema">Conta pra gente</a> —
        pode virar a próxima página do portal.
      </p>
    </div>
  </section>
</Layout>

<style>
  /* ---------- HERO ---------- */
  .hero {
    position: relative;
    background: var(--command);
    color: #fff;
    padding: clamp(4rem, 9vw, 7rem) 0 clamp(3.5rem, 7vw, 5.5rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 55% at 15% 0%, rgba(13, 138, 99, 0.30), transparent 65%),
      radial-gradient(ellipse 60% 50% at 92% 12%, rgba(240, 135, 44, 0.22), transparent 62%),
      linear-gradient(180deg, var(--command-2) 0%, var(--command) 68%);
  }
  .hero-inner {
    position: relative;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .hero-inner { grid-template-columns: 1fr; }
  }
  .hero h1 { color: #fff; }
  .hero h1 .hl {
    display: block;
    background: linear-gradient(95deg, var(--accent-lt), var(--brand-lt));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .hero-lede {
    font-size: clamp(1.05rem, 1.7vw, 1.22rem);
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.76);
    max-width: 40rem;
    margin: 1.3rem 0 2.1rem;
  }
  .hero-lede strong { color: #fff; font-weight: 600; }

  /* ---------- MINI-DIAGNÓSTICO NO HERO ---------- */
  .hero-calc {
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--radius-lg);
    padding: clamp(1.4rem, 3vw, 1.9rem);
    backdrop-filter: blur(6px);
    box-shadow: 0 18px 44px rgba(0, 0, 0, 0.28);
  }
  .hc-titulo {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.12rem;
    letter-spacing: -0.02em;
    color: #fff;
    margin: 0 0 1.25rem;
  }
  .hc-campo { margin-bottom: 1.05rem; }
  .hc-campo label {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 0.75rem;
    font-size: 0.875rem;
    color: rgba(255, 255, 255, 0.72);
    margin-bottom: 0.5rem;
  }
  .hc-campo output {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--accent-lt);
    flex: none;
  }
  .hc-campo input[type="range"] {
    -webkit-appearance: none;
    appearance: none;
    width: 100%;
    height: 5px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.18);
    outline: none;
    margin: 0;
  }
  .hc-campo input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--accent-lt);
    border: 3px solid #0d1017;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.4);
  }
  .hc-campo input[type="range"]::-moz-range-thumb {
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--accent-lt);
    border: 3px solid #0d1017;
    cursor: pointer;
  }
  .hc-campo input[type="range"]:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }

  .hc-saida {
    margin: 1.4rem 0 1.15rem;
    padding-top: 1.2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }
  .hc-rotulo {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.55);
    margin: 0 0 0.35rem;
  }
  .hc-valor {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(2.1rem, 6vw, 2.9rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #FF8FB2;
    margin: 0 0 0.45rem;
    word-break: break-word;
  }
  .hc-nota { font-size: 0.85rem; line-height: 1.5; color: rgba(255, 255, 255, 0.6); margin: 0; }
  .hc-btn { display: block; width: 100%; text-align: center; }
  .hc-ps {
    font-size: 0.78rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.5);
    margin: 0.7rem 0 0;
    text-align: center;
  }

  .trust {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    list-style: none;
    margin: 1rem 0 0;
    padding: 2rem 0 0;
    border-top: 1px solid var(--line-dk);
  }
  .trust li {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    font-size: 0.925rem;
    color: rgba(255, 255, 255, 0.68);
  }
  .tick {
    display: grid;
    place-items: center;
    width: 1.35rem;
    height: 1.35rem;
    border-radius: 999px;
    background: rgba(52, 211, 157, 0.14);
    color: var(--brand-lt);
    font-size: 0.72rem;
    flex: none;
  }

  /* ---------- PRODUTO PRÓPRIO EM DESTAQUE ---------- */
  .flagship {
    background: linear-gradient(150deg, #0D1B2A 0%, #12283C 55%, #0D1B2A 100%);
    color: #fff;
    padding: clamp(2.75rem, 6vw, 4.5rem) 0;
    border-bottom: 1px solid var(--line-dk);
  }
  .flagship-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 3.5rem);
    align-items: center;
  }
  @media (max-width: 900px) {
    .flagship-inner { grid-template-columns: 1fr; }
    .flagship-media { order: -1; max-width: 22rem; margin: 0 auto; }
  }
  .flagship-eyebrow {
    color: #34D39D;
    margin-bottom: 0.9rem;
  }
  .flagship-title {
    color: #fff;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(1.7rem, 3.6vw, 2.35rem);
    line-height: 1.16;
    letter-spacing: -0.02em;
    margin: 0 0 1.1rem;
  }
  .flagship-title .hl {
    display: block;
    background: linear-gradient(95deg, #FF8FB2, #34D39D);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  .flagship-lede {
    font-size: clamp(1rem, 1.6vw, 1.1rem);
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.78);
    max-width: 34rem;
    margin: 0 0 1.75rem;
  }
  .flagship-lede strong { color: #fff; font-weight: 600; }
  .flagship-cta { display: flex; flex-wrap: wrap; gap: 0.85rem; }
  .flagship-media img {
    width: 100%;
    height: auto;
    display: block;
    filter: drop-shadow(0 18px 40px rgba(0, 0, 0, 0.35));
  }

  /* ---------- BARRA DE NÚMEROS ---------- */
  .stats-bar {
    background: var(--command-2);
    border-bottom: 1px solid var(--line-dk);
  }
  .stats-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(2rem, 6vw, 4.5rem);
    padding: 1.5rem 0;
  }
  .stat { display: flex; align-items: baseline; gap: 0.5em; }
  .stat strong {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.5rem;
    color: var(--accent-lt);
  }
  .stat span {
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.68);
  }

  /* ---------- ARTIGOS EM DESTAQUE ---------- */
  .articles-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 1000px) {
    .articles-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .articles-grid { grid-template-columns: 1fr; }
  }
  .see-all-articles {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    margin-top: 1.75rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.98rem;
    color: var(--brand-dk);
  }
  .see-all-articles:hover { color: var(--accent-dk); }

  /* ---------- OFERTAS ---------- */
  .offers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 1000px) {
    .offers-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .offers-grid { grid-template-columns: 1fr; }
  }

  /* ---------- CRITÉRIOS ---------- */
  .criteria-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.75rem;
  }
  @media (max-width: 1000px) {
    .criteria-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .criteria-grid { grid-template-columns: 1fr; }
  }
  .criterion { padding-top: 1.1rem; border-top: 2px solid var(--line); }
  .criterion-n {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.85rem;
    letter-spacing: 0.06em;
    color: var(--brand);
  }
  .criterion h3 { margin: 0.5rem 0 0.4rem; }
  .criterion p { color: var(--ink-soft); font-size: 0.95rem; margin: 0; }

  /* ---------- PASSOS ---------- */
  .steps {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 880px) {
    .steps { grid-template-columns: 1fr; }
  }
  .step {
    background: var(--paper);
    border: 1px solid var(--line);
    border-radius: var(--radius-lg);
    padding: 1.75rem;
    box-shadow: var(--shadow-sm);
  }
  .step-n {
    display: inline-grid;
    place-items: center;
    min-width: 2.5rem;
    height: 2.5rem;
    padding: 0 0.6rem;
    border-radius: var(--radius-sm);
    background: var(--command);
    color: var(--accent-lt);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.92rem;
  }
  .step h3 { margin: 1rem 0 0.4rem; }
  .step p { color: var(--ink-soft); font-size: 0.96rem; margin: 0; }

  /* ---------- CTA FINAL ---------- */
  .final-cta {
    background: var(--command);
    color: #fff;
    padding: clamp(3.5rem, 7vw, 5.5rem) 0;
  }
  .final-inner { text-align: center; }
