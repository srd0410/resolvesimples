<script is:inline>
// Mini-diagnóstico do hero. Usa a mesma conta da calculadora completa
// (faltas × ticket × 12), só que sem o campo de reocupação — por isso o
// resultado é sempre rotulado como "antes de descontar o que você reocupa".
// Os números seguem na URL para a pessoa não digitar tudo de novo.
(function () {
  var $ = function (id) { return document.getElementById(id); };
  var ag = $("hcAgendados"), fa = $("hcFaltas"), ti = $("hcTicket");
  if (!ag || !fa || !ti) return;

  var brl = function (v) { return "R$ " + Math.round(v).toLocaleString("pt-BR"); };

  function atualizar() {
    var vAg = +ag.value, vFa = +fa.value, vTi = +ti.value;

    // Faltas não podem passar do total de atendimentos marcados.
    if (vFa > vAg) { vFa = vAg; fa.value = vFa; }

    $("hcOutAgendados").textContent = vAg;
    $("hcOutFaltas").textContent = vFa;
    $("hcOutTicket").textContent = brl(vTi);

    var perdaAno = vFa * vTi * 12;
    $("hcValor").textContent = brl(perdaAno);
    $("hcNota").textContent = vFa === 0
      ? "Nenhuma falta no mês? Raro — e vale proteger para continuar assim."
      : "Antes de descontar o que você consegue reocupar.";

    var destino = "/calculadora-agenda-vazia/?agendados=" + vAg +
      "&cancel=" + vFa + "&ticket=" + vTi + "#calculadora";
    $("hcCta").href = destino;
    // Os demais botões que levam à calculadora carregam os mesmos números,
    // para quem mexeu nos controles e só clicou lá embaixo.
    document.querySelectorAll("[data-calc-link]").forEach(function (a) {
      a.href = destino;
    });
  }

  [ag, fa, ti].forEach(function (el) { el.addEventListener("input", atualizar); });
  atualizar();
})();
</script>
