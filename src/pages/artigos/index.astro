---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import BannerHero from '../../components/BannerHero.astro';
import { getCollection } from 'astro:content';
import type { ImageMetadata } from 'astro';

// Banner do acervo: src/assets/banners/acervo-artigos-banner.jpg (opcional).
const found = import.meta.glob<{ default: ImageMetadata }>('../../assets/banners/acervo-artigos-banner.jpg', { eager: true });
const banner = Object.values(found)[0]?.default;
const bannerAlt = "Caderno aberto, caneta, xícara, pote, fone e pano verde organizados sobre mesa.";

const allArtigos = (await getCollection('artigos', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<Layout
  title="Artigos e comparativos"
  description="Comparativos objetivos e guias práticos para escolher o produto certo, sem enrolação e sem ficha técnica que não importa."
>
  <BannerHero image={banner} alt={bannerAlt} width="44rem">
    <p slot="top" class="eyebrow eyebrow-on-dark">Artigos</p>
    <h1>Comparativos e guias, sem enrolação.</h1>
    <p slot="detail" class="hero-lede">
      Antes de qualquer indicação, a gente explica o porquê. Aqui você encontra os
      comparativos completos por trás da seleção de cada área do site.
    </p>
  </BannerHero>

  <section class="section">
    <div class="wrap">
      {allArtigos.length > 0 ? (
        <div class="posts-grid">
          {allArtigos.map((post) => (
            <ArticleCard
              href={`/artigos/${post.slug}/`}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              niches={post.data.niches}
            />
          ))}
        </div>
      ) : (
        <p class="empty">Ainda não publicamos nenhum artigo. Volte em breve.</p>
      )}
    </div>
  </section>
</Layout>

<style>
  :global(.hero) h1 { color: #fff; }
  .hero-lede {
    font-size: clamp(1.02rem, 1.6vw, 1.16rem);
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.76);
    margin: 1.2rem 0 0;
  }

  .posts-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(19rem, 1fr));
    gap: 1.25rem;
  }

  .empty { color: var(--ink-soft); }
</style>
