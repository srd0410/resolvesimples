---
import Layout from '../../layouts/Layout.astro';
import OfferCard from '../../components/OfferCard.astro';
import RelatedPosts from '../../components/RelatedPosts.astro';
import { getCollection } from 'astro:content';
import { getOffer, SITE } from '../../consts';

export async function getStaticPaths() {
  const allArtigos = await getCollection('artigos', ({ data }) => !data.draft);
  return allArtigos.map((post) => ({
    params: { slug: post.slug },
    props: { post, allArtigos },
  }));
}

const { post, allArtigos } = Astro.props;
const { Content, headings } = await post.render();
// Sumário montado no servidor a partir dos H2 (o Astro já gera o id de cada título).
const toc = headings.filter((h) => h.depth === 2);
const relatedOffers = post.data.niches.map(getOffer).filter(Boolean);
const formattedDate = post.data.pubDate.toLocaleDateString('pt-BR', {
  day: '2-digit',
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
});

const canonicalUrl = new URL(`/artigos/${post.slug}/`, SITE.url).toString();
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  publisher: { '@type': 'Organization', name: SITE.name, url: SITE.url },
  mainEntityOfPage: canonicalUrl,
};
---
<Layout title={post.data.title} description={post.data.description}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <article>
    <section class="hero">
      <div class="hero-bg" aria-hidden="true"></div>
      <div class="wrap-narrow hero-inner">
        <nav class="crumbs" aria-label="Você está em">
          <a href="/">Início</a>
          <span aria-hidden="true">/</span>
          <a href="/artigos/">Artigos</a>
        </nav>
        <p class="eyebrow eyebrow-on-dark">Comparativo</p>
        <h1>{post.data.title}</h1>
        <p class="hero-lede">{post.data.description}</p>
        <p class="byline">Publicado em {formattedDate}</p>
      </div>
    </section>

    <section class="section">
      {toc.length >= 3 && (
        <div class="wrap-narrow">
          <details class="toc" id="art-toc" data-pagefind-ignore>
            <summary class="toc-summary">
              <span class="toc-label">Neste comparativo</span>
              <span class="toc-count">{toc.length} tópicos</span>
            </summary>
            <nav aria-label="Sumário do artigo">
              <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
            </nav>
          </details>
        </div>
      )}
      <div class="wrap-narrow prose">
        <Content />
      </div>
      <div class="wrap-narrow">
        <div class="share" data-pagefind-ignore>
          <p class="share-label">Compartilhe com quem está na dúvida</p>
          <div class="share-btns">
            <a class="share-btn share-wa" href={`https://wa.me/?text=${encodeURIComponent(`${post.data.title} — ${canonicalUrl}`)}`} target="_blank" rel="noopener" data-share="whatsapp">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.4.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2c0 1.3.9 2.5 1 2.7.1.2 1.8 2.8 4.4 3.9 1.6.7 2.3.8 3.1.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg>
              WhatsApp
            </a>
            <button type="button" class="share-btn share-copy" data-share="copiar" data-url={canonicalUrl}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7"/><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7"/></svg>
              <span>Copiar link</span>
            </button>
          </div>
        </div>
        <RelatedPosts current={post} allArticles={allArtigos} />
      </div>
    </section>

    <script is:inline>
      (function () {
        var t = document.getElementById('art-toc');
        if (t) t.addEventListener('click', function (e) { if (e.target.closest('a')) t.open = false; });
        var g = function () { if (typeof window.gtag === 'function') window.gtag.apply(null, arguments); else (window.dataLayer = window.dataLayer || []).push(arguments); };
        document.querySelectorAll('[data-share]').forEach(function (b) {
          b.addEventListener('click', function () { g('event', 'share_click', { method: b.getAttribute('data-share'), page_path: location.pathname }); });
        });
        var c = document.querySelector('.share-copy');
        if (!c) return;
        c.addEventListener('click', function () {
          var url = c.getAttribute('data-url');
          var r = c.querySelector('span');
          function ok() { r.textContent = 'Link copiado'; setTimeout(function () { r.textContent = 'Copiar link'; }, 2200); }
          if (navigator.share && window.matchMedia('(pointer: coarse)').matches) navigator.share({ title: document.title, url: url }).catch(function () {});
          else if (navigator.clipboard) navigator.clipboard.writeText(url).then(ok, function () { window.prompt('Copie o link:', url); });
          else window.prompt('Copie o link:', url);
        });
      })();
    </script>

    {relatedOffers.length > 0 && (
      <section class="section section-tint">
        <div class="wrap">
          <div class="section-head">
            <p class="eyebrow">Continue por aqui</p>
            <h2>Veja a seleção completa da área.</h2>
          </div>
          <div class="offers-grid">
            {relatedOffers.map((offer) => offer && <OfferCard offer={offer} />)}
          </div>
        </div>
      </section>
    )}
  </article>
</Layout>

<style>
  .hero {
    position: relative;
    background: var(--command);
    color: #fff;
    padding: clamp(2.5rem, 5vw, 3.5rem) 0 clamp(2.75rem, 5.5vw, 4rem);
    overflow: hidden;
    isolation: isolate;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(ellipse 70% 55% at 12% 0%, rgba(13, 138, 99, 0.28), transparent 65%),
      radial-gradient(ellipse 55% 50% at 95% 15%, rgba(240, 135, 44, 0.20), transparent 62%),
      linear-gradient(180deg, var(--command-2) 0%, var(--command) 70%);
  }
  .hero-inner { position: relative; }
  .hero h1 { color: #fff; font-size: clamp(1.9rem, 4.2vw, 2.75rem); }
  .hero-lede {
    font-size: clamp(1rem, 1.5vw, 1.1rem);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.76);
    margin: 1rem 0 0;
  }
  .byline { font-size: 0.85rem; color: rgba(255, 255, 255, 0.5); margin: 1.4rem 0 0; }

  .crumbs {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 1.4rem;
  }
  .crumbs a { color: rgba(255, 255, 255, 0.78); text-decoration: none; display: inline-flex; align-items: center; min-height: var(--tap); }
  .byline { color: rgba(255, 255, 255, 0.66) !important; }

  /* Sumário recolhível */
  .toc {
    border: 1px solid var(--line); border-left: 3px solid var(--brand);
    border-radius: var(--radius); background: var(--paper-2);
    margin: 0 0 2rem;
  }
  .toc-summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1rem;
    min-height: 52px; padding: 0 1.1rem; cursor: pointer; list-style: none;
  }
  .toc-summary::-webkit-details-marker { display: none; }
  .toc-label { font-size: 0.75rem; font-weight: 700; letter-spacing: 0.11em; text-transform: uppercase; color: var(--brand-dk); }
  .toc-count { display: inline-flex; align-items: center; gap: 0.5rem; font-size: 0.82rem; color: var(--ink-soft); }
  .toc-count::after {
    content: ''; width: 8px; height: 8px;
    border-right: 2px solid var(--brand-dk); border-bottom: 2px solid var(--brand-dk);
    transform: rotate(45deg) translateY(-2px); transition: transform 0.15s ease;
  }
  .toc[open] .toc-count::after { transform: rotate(-135deg) translateY(-2px); }
  .toc nav { padding: 0 1.2rem 0.8rem; border-top: 1px solid var(--line); }
  .toc ol { margin: 0.4rem 0 0; padding-left: 1.2rem; }
  .toc li { margin: 0; }
  .toc a { display: flex; align-items: center; min-height: var(--tap); padding: 0.25rem 0; color: var(--ink); text-decoration: none; line-height: 1.35; }
  .toc a:hover { color: var(--accent-text); }

  /* Compartilhar */
  .share {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 0.6rem 1rem;
    margin: 2.2rem 0 0.5rem; padding: 0.9rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line);
  }
  .share-label { margin: 0; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-soft); }
  .share-btns { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .share-btn {
    display: inline-flex; align-items: center; gap: 0.5rem;
    min-height: var(--tap); padding: 0 1.05rem;
    border: 1px solid var(--line-2); border-radius: 999px; background: var(--paper);
    font: inherit; font-size: 0.9rem; font-weight: 600; color: var(--ink);
    text-decoration: none; cursor: pointer;
  }
  .share-btn svg { width: 18px; height: 18px; }
  .share-wa svg { color: #1f8f4e; }
  .share-btn:hover { border-color: var(--ink-soft); color: var(--ink); }

  /* Tabelas: rolagem própria no celular em vez de alargar a página */
  @media (max-width: 640px) {
    .prose :global(table) { display: block; overflow-x: auto; }
    .prose :global(th), .prose :global(td) { min-width: 7.5rem; }
  }
  .crumbs a:hover { color: var(--accent-lt); }

  .prose :global(h2) {
    margin-top: 2.2em;
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
  }
  .prose :global(h3) {
    margin-top: 1.8em;
    font-size: clamp(1.1rem, 2vw, 1.25rem);
  }
  .prose :global(p) {
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--ink-2);
  }
  .prose :global(ul),
  .prose :global(ol) {
    padding-left: 1.3em;
    color: var(--ink-2);
    font-size: 1.02rem;
    line-height: 1.7;
  }
  .prose :global(li) { margin-bottom: 0.4em; }
  .prose :global(strong) { color: var(--ink); }
  .prose :global(blockquote) {
    margin: 1.6em 0;
    padding: 0.2em 1.2em;
    border-left: 3px solid var(--brand);
    background: var(--paper-2);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--ink-soft);
  }
  .prose :global(hr) {
    border: none;
    border-top: 1px solid var(--line);
    margin: 2.2em 0;
  }
  .prose :global(a) { font-weight: 600; }
  .prose :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.6em 0;
    font-size: 0.95rem;
  }
  .prose :global(th),
  .prose :global(td) {
    text-align: left;
    padding: 0.65em 0.8em;
    border-bottom: 1px solid var(--line);
  }
  .prose :global(thead th) {
    color: var(--ink-soft);
    font-weight: 600;
    font-size: 0.82rem;
    text-transform: uppercase;
    letter-spacing: 0.02em;
  }

  .offers-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }
  @media (max-width: 1000px) {
    .offers-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 640px) {
    .offers-grid { grid-template-columns: 1fr; }
  }
</style>
