---
// Página de resultado pós-diagnóstico do Protocolo VAGA.
// Chega aqui via redirect JS depois do envio do formulário da calculadora
// (F:\Sites\site-afiliados\src\pages\calculadora-agenda-vazia\index.astro),
// com os números calculados na query string. O envio real do lead pra Brevo
// acontece num iframe oculto na página anterior — esta página só lê os
// parâmetros da URL e personaliza o texto, não depende de nenhum backend.
//
// Fora do Layout.astro de propósito, igual à calculadora: landing de
// conversão, sem menu do portal. Não indexável (é conteúdo pessoal/duplicado
// por natureza — cada visita gera números diferentes na URL).
import { SITE } from '../../../consts';

const title = 'Seu diagnóstico está pronto — Protocolo VAGA';
const canonical = new URL('/calculadora-agenda-vazia/obrigado/', SITE.url).toString();
---
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>{title}</title>
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<meta name="robots" content="noindex,nofollow" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet" />

{SITE.gaMeasurementId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.gaMeasurementId}`}></script>}
{SITE.gaMeasurementId && (
  <script is:inline define:vars={{ gaMeasurementId: SITE.gaMeasurementId }}>
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }
    gtag('js', new Date());
    gtag('config', gaMeasurementId);
    gtag('event', 'calc_diagnostico_entregue');
  </script>
)}

<style is:global set:html={`
:root{
    --ink:#0D1B2A; --ink-soft:#2B3B4A; --ink-faint:#5A6B7C;
    --paper:#F2F4F7; --paper-raised:#FFFFFF; --line:#DDE3EA;
    --lost:#B0214E; --lost-wash:#FBEAF0;
    --kept:#00A78E; --kept-wash:#E5F7F3; --idle:#E7EBF0;
    --blue:#1565C0; --blue-wash:#EAF2FC;
    --radius:14px; --maxw:640px;
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-text-size-adjust:100%;scroll-behavior:smooth}
  body{
    background:var(--paper);color:var(--ink);
    font-family:"Poppins",-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
    font-size:17px;line-height:1.55;-webkit-font-smoothing:antialiased;padding:0 20px 80px;
  }
  .wrap{max-width:var(--maxw);margin:0 auto}

  .masthead{padding:26px 0 0;display:flex;align-items:center;gap:9px}
  .mark{width:9px;height:9px;background:var(--lost);border-radius:2px;transform:rotate(45deg)}
  .brand{font-family:"IBM Plex Mono",monospace;font-size:12px;letter-spacing:.13em;text-transform:uppercase;color:var(--ink-soft);text-decoration:none}
  .lang-switch{margin-left:auto;font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:var(--ink-soft);text-decoration:none;border:1px solid var(--line);border-radius:999px;padding:7px 11px}
  .lang-switch:hover{color:var(--ink);border-color:var(--ink-soft);background:var(--paper-raised)}

  .hero{padding:34px 0 6px}
  .eyebrow{font-family:"IBM Plex Mono",monospace;font-size:11.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--kept);margin-bottom:16px}
  h1{font-family:"Poppins",sans-serif;font-weight:800;font-size:clamp(28px,7.4vw,38px);line-height:1.08;letter-spacing:-.026em;margin-bottom:14px}
  .deck{font-size:17px;color:var(--ink-soft);max-width:32em}

  h2{font-family:"Poppins",sans-serif;font-weight:700;font-size:clamp(23px,5.6vw,27px);line-height:1.16;letter-spacing:-.02em;margin:40px 0 12px}

  .result{background:var(--ink);color:var(--paper);border-radius:var(--radius);padding:28px 22px 24px;margin-top:24px}
  .result-label{font-family:"IBM Plex Mono",monospace;font-size:11.5px;letter-spacing:.13em;text-transform:uppercase;color:#B9C4CF;margin-bottom:10px}
  .big{font-family:"Poppins",sans-serif;font-weight:800;font-size:clamp(42px,13vw,64px);line-height:.95;letter-spacing:-.035em;color:#FF8FB2;margin-bottom:6px;word-break:break-word}
  .big-note{font-size:15px;color:#B9C4CF}
  .split{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:22px;padding-top:20px;border-top:1px solid #22364A}
  .stat-k{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#B9C4CF;margin-bottom:5px;line-height:1.3}
  .stat-v{font-family:"Poppins",sans-serif;font-weight:700;font-size:22px;letter-spacing:-.02em}

  .bridge{margin-top:30px}
  .bridge h2{margin-top:0}
  .bridge p{color:var(--ink-soft);font-size:16px;line-height:1.6}

  .personas{margin-top:8px}
  .personas h2{margin-top:0;margin-bottom:6px}
  .personas .lede{font-size:16px;color:var(--ink-soft);margin-bottom:20px}
  .persona-list{display:flex;flex-direction:column;gap:14px}
  .persona{background:var(--paper-raised);border:1px solid var(--line);border-left:4px solid var(--lost);border-radius:10px;padding:16px 18px}
  .persona .quem{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--lost);margin-bottom:6px;font-weight:600}
  .persona p:last-child{margin:0;font-size:15.5px;line-height:1.55;color:var(--ink-soft)}

  .oferta{background:var(--ink);color:var(--paper);border-radius:var(--radius);padding:30px 22px 26px;margin-top:36px}
  .oferta .selo{font-family:"IBM Plex Mono",monospace;font-size:11px;letter-spacing:.13em;text-transform:uppercase;color:var(--kept);margin-bottom:12px;font-weight:600}
  .oferta h2{font-family:"Poppins",sans-serif;font-weight:800;font-size:clamp(25px,6.6vw,32px);line-height:1.12;letter-spacing:-.02em;color:#FFFFFF;margin:0 0 14px}
  .oferta .lead{font-size:16px;line-height:1.6;color:#B9C4CF;margin:0 0 22px}
  .oferta .lead strong{color:#FFFFFF}
  .oferta .product-shot{margin:0 0 22px}
  .oferta .product-shot img{display:block;width:100%;height:auto;border-radius:10px;background:#FFFFFF}
  .oferta .product-shot figcaption{font-size:12.5px;line-height:1.45;color:#8FA0B0;margin-top:8px}
  .oferta ul{list-style:none;margin:0 0 22px;padding:0}
  .oferta li{position:relative;padding-left:24px;margin-bottom:11px;font-size:15.5px;line-height:1.55;color:#D6DEE6}
  .oferta li::before{content:"";position:absolute;left:0;top:8px;width:9px;height:9px;background:var(--kept);border-radius:2px}
  .oferta li b{color:#FFFFFF;font-weight:600}
  .oferta .preco{border-top:1px solid #22364A;border-bottom:1px solid #22364A;padding:22px 0;margin-bottom:22px}
  .oferta .ancora{font-size:15px;line-height:1.5;color:#B9C4CF;margin:0 0 10px}
  .oferta .ancora b{color:#FF8FB2;font-weight:700}
  .oferta .ancora[hidden]{display:none}
  .oferta .de{font-family:"IBM Plex Mono",monospace;font-size:12px;letter-spacing:.1em;text-transform:uppercase;color:#B9C4CF;margin-bottom:6px}
  .oferta .valor{font-family:"Poppins",sans-serif;font-weight:800;font-size:clamp(38px,11vw,52px);line-height:1;letter-spacing:-.03em;color:#FFFFFF;margin-bottom:6px}
  .oferta .cond{font-size:14.5px;color:#B9C4CF;margin-bottom:22px}
  .oferta .btn{display:block;width:100%;box-sizing:border-box;text-align:center;background:var(--kept);color:#FFFFFF;text-decoration:none;font-family:"Poppins",sans-serif;font-weight:700;font-size:17.5px;padding:18px;border-radius:9px;transition:background .18s ease,transform .12s ease}
  .oferta .btn:hover{background:#00C0A2}
  .oferta .btn:active{transform:translateY(1px)}
  .oferta .btn:focus-visible{outline:3px solid #FFFFFF;outline-offset:3px}
  .oferta .delivery-note{font-size:12.5px;line-height:1.45;color:#8FA0B0;text-align:center;margin:12px 0 0}
  .oferta .garantia{display:flex;gap:12px;align-items:flex-start;margin-top:20px;padding-top:20px;border-top:1px solid #22364A}
  .oferta .garantia .marca{flex:none;width:34px;height:34px;border-radius:8px;background:#12324A;color:var(--kept);font-family:"Poppins",sans-serif;font-weight:800;font-size:15px;display:flex;align-items:center;justify-content:center}
  .oferta .garantia p{margin:0;font-size:14.5px;line-height:1.55;color:#B9C4CF}
  .oferta .garantia strong{color:#FFFFFF}
  .oferta .ps{margin:18px 0 0;font-size:13.5px;line-height:1.55;color:#8FA0B0}

  .autoria{
    background:var(--paper-raised);border:1px solid var(--line);
    border-left:3px solid var(--kept);
    border-radius:var(--radius);padding:22px 20px;margin-top:26px;
  }
  .autoria-marca{
    font-family:"Poppins",sans-serif;font-weight:700;font-size:17px;
    letter-spacing:-.02em;color:var(--ink);margin:0 0 12px;
  }
  .autoria-marca strong{font-weight:800;color:var(--kept)}
  .autoria p{margin:0 0 12px;font-size:15.5px;line-height:1.62;color:var(--ink-soft)}
  .autoria p:last-child{margin-bottom:0}
  .autoria strong{color:var(--ink)}
  .maissobre{margin-top:34px;text-align:center;padding:20px 0 4px}
  .maissobre p{font-size:14.5px;color:var(--ink-faint);margin-bottom:8px}
  .backlink{display:inline-block;font-weight:600;color:var(--lost);text-decoration:none;border-bottom:1.5px solid currentColor}

  @media (prefers-reduced-motion:reduce){*{transition:none!important;animation:none!important}html{scroll-behavior:auto}}
`}></style>
</head>
<body>
<div class="wrap">

  <header class="masthead">
    <div class="mark" aria-hidden="true"></div>
    <a class="brand" href="/">Resolve Simples</a>
    <a class="lang-switch" href="/en/no-show-calculator/" lang="en" hreflang="en" aria-label="View VAGA Protocol in English">English</a>
  </header>

  <main>
  <article>

  <section class="hero">
    <div class="eyebrow">Diagnóstico pronto</div>
    <h1 id="titulo">Prontinho! Aqui está o tamanho do buraco.</h1>
    <p class="deck" id="deck">Com base no que você preencheu na calculadora, é isso que está saindo da sua agenda sem voltar.</p>
  </section>

  <section class="result" aria-live="polite">
    <div class="result-label">Deixou de entrar em 12 meses</div>
    <div class="big" id="anual">—</div>
    <div class="big-note" id="anualNote">Projeção anual a partir dos seus últimos 30 dias.</div>
    <div class="split">
      <div><div class="stat-k">Nos últimos 30 dias</div><div class="stat-v" id="mensal">—</div></div>
      <div><div class="stat-k">Horas de cadeira parada por ano</div><div class="stat-v" id="horas">—</div></div>
    </div>
  </section>

  <section class="bridge">
    <h2>Isso não é um número pra assustar. É o tamanho do que dá pra recuperar.</h2>
    <p>Esse valor não é hipotético — saiu direto dos números que você acabou de informar. E ele não pára de crescer sozinho: continua rodando todo mês até que alguém mude o que acontece nos <strong>15 minutos</strong> depois de cada cancelamento. É exatamente isso que o Protocolo VAGA ensina a fazer, em quatro etapas prontas pra aplicar hoje.</p>
  </section>

  <section class="personas">
    <h2>Pra quem é o Protocolo VAGA</h2>
    <p class="lede">Não importa quem aperta o "comprar" — o resultado aparece pra três pessoas diferentes.</p>
    <div class="persona-list">
      <div class="persona">
        <p class="quem">Se você é dona e vai repassar pra equipe</p>
        <p>Você não quer ficar lembrando, cobrando e repetindo a mesma instrução toda semana. O manual da recepção e o Cartão dos 15 Minutos fazem esse trabalho por você — sua equipe executa sozinha, mesmo nos dias em que você não está olhando.</p>
      </div>
      <div class="persona">
        <p class="quem">Se você é dona e cuida da agenda sozinha</p>
        <p>Você não tem fim de semana livre pra montar planilha, testar mensagem e pesquisar o que funciona. Por R$ 47, alguém já pesquisou, testou e organizou — inclusive pra quem está começando como MEI, onde cada real de custo pesa e cada horário recuperado conta em dobro.</p>
      </div>
      <div class="persona">
        <p class="quem">Se você é quem cuida da agenda, mas não é a dona</p>
        <p>Aplicar o Protocolo e mostrar o resultado em números — no Painel da Agenda, preto no branco — é argumento concreto pra levar pra sua gestora. Melhorou a reocupação, melhorou o caixa: é assim que se justifica um aumento.</p>
      </div>
    </div>
  </section>

  <section class="oferta" aria-labelledby="oferta-titulo" id="protocolo-vaga">
    <p class="selo">Uma vaga de R$ 47 recuperada já compensa o investimento</p>
    <h2 id="oferta-titulo">Protocolo VAGA</h2>
    <p class="lead">Transforme o diagnóstico que acabou de ver em um processo para <strong>medir, evitar e reocupar horários vagos.</strong></p>
    <figure class="product-shot">
      <img src="/images/vaga/mockup-protocolo-vaga.png" alt="Materiais digitais do Protocolo VAGA, com planilha, mensagens e guia de ação" width="1456" height="1092" loading="lazy" decoding="async" />
      <figcaption>Kit digital pronto para quem administra o negócio e para quem cuida da agenda.</figcaption>
    </figure>
    <div class="preco">
      <p class="ancora" id="ancoraPreco" hidden></p>
      <p class="de">Pagamento único</p>
      <p class="valor">R$ 47</p>
      <p class="cond">Acesso digital imediato após a aprovação. Sem mensalidade e sem depender de software pago.</p>
      <a class="btn" data-checkout data-cta-position="thank_you_offer" href="https://pay.kiwify.com.br/qkgpS7Q">Quero o Protocolo VAGA por R$ 47</a>
      <p class="delivery-note">Checkout seguro pela Kiwify · Cartão, Pix ou boleto · Garantia de 30 dias</p>
    </div>
    <ul>
      <li><b>Medir:</b> Painel da Agenda com faltas, vagas recuperadas e receita em risco.</li>
      <li><b>Evitar:</b> 40 mensagens, políticas editáveis e guia do WhatsApp para conseguir confirmação ou aviso mais cedo.</li>
      <li><b>Reocupar:</b> Lista de Encaixe, Cartão dos 15 Minutos, manual da recepção e plano de 7 dias.</li>
    </ul>
    <p class="lead">Duas planilhas, 40 mensagens, cinco documentos editáveis, manual de equipe e plano de implantação — prontos para usar. <strong>O primeiro passo você aplica no mesmo dia</strong>: o Cartão dos 15 Minutos é uma página só. O plano de 7 dias distribui o resto sem travar o atendimento.</p>
    <p class="lead">Dúvida depois de comprar? Escreve para <a href="mailto:contato@resolvesimples.com.br">contato@resolvesimples.com.br</a>.</p>
    <div class="garantia">
      <div class="marca" aria-hidden="true">30</div>
      <p><strong>Garantia de 30 dias.</strong> Aplica, mede no Painel, e se não vir diferença nos seus números, devolvo tudo — sem justificativa. O risco fica todo do meu lado.</p>
    </div>
    <p class="ps">Guardamos o seu diagnóstico. Se preferir pensar com calma, pode voltar nesta página quando quiser.</p>
  </section>

  <section class="autoria">
    <p class="autoria-marca">Resolve <strong>Simples</strong></p>
    <p>O Protocolo VAGA é <strong>produto próprio da Resolve Simples</strong> — não é indicação de terceiro e não existe comissão de afiliado envolvida. E o diagnóstico que você acabou de receber usa <strong>os seus números</strong>, não uma média inventada de mercado: não existe estatística brasileira confiável de faltas para o setor, e a gente prefere dizer isso a fabricar uma.</p>
    <p><a class="backlink" href="/calculadora-agenda-vazia/#quem-faz">Ver quem faz o Protocolo VAGA</a></p>
  </section>

  <section class="maissobre">
    <p>Quer entender o método com mais detalhe antes de decidir?</p>
    <a class="backlink" href="/calculadora-agenda-vazia/#como-funciona">Ver como o Protocolo VAGA funciona, passo a passo</a>
  </section>

  </article>
  </main>

</div>
<script is:inline>
(function(){
  "use strict";
  var $ = function(id){ return document.getElementById(id); };
  var p = new URLSearchParams(window.location.search);

  var nome = (p.get("nome") || "").trim();
  var perdaAnoTxt = p.get("perdaAnoTxt");
  var perdaMesTxt = p.get("perdaMesTxt");
  var horas = p.get("horas");
  var perdidas = p.get("perdidas");
  var agendados = p.get("agendados");
  var taxa = p.get("taxa");

  if (perdaAnoTxt) {
    document.title = "Diagnóstico: " + perdaAnoTxt + " por ano — Protocolo VAGA";
    $("titulo").textContent = nome
      ? "Prontinho, " + nome + "! Aqui está o tamanho do buraco."
      : "Prontinho! Aqui está o tamanho do buraco.";
    $("anual").textContent = perdaAnoTxt;
    $("mensal").textContent = perdaMesTxt || "—";
    $("horas").textContent = horas ? (Number(horas).toLocaleString("pt-BR") + " h") : "—";
    if (perdidas && agendados) {
      $("anualNote").textContent = "Equivale a " + perdidas + " de " + agendados + " atendimentos marcados nos últimos 30 dias" + (taxa ? " (" + Number(taxa).toFixed(0) + "% vazios)" : "") + ".";
    }
    // Mesma ancoragem da página da calculadora: o número da própria pessoa
    // encostado no preço, em vez de preço riscado.
    $("ancoraPreco").innerHTML = "Pelos seus números, a agenda vaza <b>" + perdaAnoTxt + "</b> por ano";
    $("ancoraPreco").hidden = false;
  } else {
    $("deck").textContent = "Não encontramos os números da sua calculadora nesta página — pode ter vindo de um link direto. Sem problema: o Protocolo VAGA continua valendo a pena de qualquer jeito.";
    document.querySelector(".result").style.display = "none";
    $("titulo").textContent = "Vamos direto ao Protocolo VAGA?";
  }

  window.dataLayer = window.dataLayer || [];
  window.dataLayer.push({ event: "pagina_obrigado_vista" });
})();
</script>
<script is:inline>
(function(){
  var keys = ["utm_source","utm_medium","utm_campaign","utm_content","utm_term"];
  var incoming = new URLSearchParams(window.location.search);
  document.querySelectorAll("a[data-checkout]").forEach(function(link){
    var url = new URL(link.href);
    keys.forEach(function(key){ if (incoming.get(key)) url.searchParams.set(key, incoming.get(key)); });
    link.href = url.toString();
    link.addEventListener("click", function(){
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({event:"begin_checkout",language:"pt-BR",cta_position:link.dataset.ctaPosition || "unknown",value:47,currency:"BRL"});
    });
  });
})();
</script>
</body>
</html>
