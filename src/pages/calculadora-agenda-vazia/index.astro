<script is:inline set:html={`
(function(){
  "use strict";

  /* Cole a URL de ação do formulário oficial da Brevo:
     Brevo > Contatos > Formulários > compartilhar/incorporar. */
  var BREVO_FORM_ACTION = "https://525be005.sibforms.com/serve/MUIFAEB7rO_ylZe7w1cWiEp_IdGYMoCwIGfnnVycjvgbp__aarKR_VGbRmG4IhzK4x0fEpxON39JaVrkUsngQDgg5mZ9xVijYe9wiOJ3zNffZ62tSp8BubotY1HU6GL-_4OOQ9ttcnwEpptZHvmgkbB6P1BXhc10SfgseXqU1L3e2B8AdzcFj3EOPlbtObxPyohTSSeEIw7HzJ1QFg==";

  var $ = function(id){ return document.getElementById(id); };

  var C = {
    ticket:      { r:$("ticket"),      n:$("numTicket"),      box:$("boxTicket"),      h:$("h_ticket"),      tocado:false },
    agendados:   { r:$("agendados"),   n:$("numAgendados"),   box:$("boxAgendados"),   h:$("h_agendados"),   tocado:false },
    cancel:      { r:$("cancel"),      n:$("numCancel"),      box:$("boxCancel"),      h:$("h_cancel"),      tocado:false },
    noshow:      { r:$("noshow"),      n:$("numNoshow"),      box:$("boxNoshow"),      h:$("h_noshow"),      tocado:false },
    recuperadas: { r:$("recuperadas"), n:$("numRecuperadas"), box:$("boxRecuperadas"), h:$("h_recuperadas"), tocado:false },
    duracao:     { r:$("duracao"),     n:$("numDuracao"),     box:$("boxDuracao"),     h:$("h_duracao"),     tocado:false }
  };
  var chaves = Object.keys(C);
  var MAX_CELLS = 96, IDLE_CELLS = 40;

  function brl(v){ return "R$ " + Math.round(v).toLocaleString("pt-BR"); }

  function ativar(k){
    var c = C[k];
    if (c.tocado) return;
    c.tocado = true;
    c.r.classList.remove("untouched");
    c.box.classList.add("set");
  }
  function erro(id, campo, texto){
    var box = $(id);
    box.textContent = texto || "";
    box.classList.toggle("show", !!texto);
    if (campo) campo.setAttribute("aria-invalid", texto ? "true" : "false");
  }
  function lido(k){
    if (!C[k].tocado) return null;
    var v = parseFloat(C[k].n.value);
    return isFinite(v) ? v : +C[k].r.value;
  }

  chaves.forEach(function(k){
    var c = C[k];
    c.r.addEventListener("input", function(){
      ativar(k); c.n.value = c.r.value; calcular(); marcar("inicio_preenchimento");
    });
    c.r.addEventListener("keydown", function(){ ativar(k); });
    c.n.addEventListener("input", function(){
      var v = parseFloat(c.n.value);
      if (!isFinite(v)){ c.tocado=false; c.r.classList.add("untouched"); c.box.classList.remove("set"); calcular(); return; }
      ativar(k);
      c.r.value = Math.min(Math.max(v, +c.r.min), +c.r.max);
      calcular(); marcar("inicio_preenchimento");
    });
  });

  function grade(total, perdidas, pronto){
    var g = $("slots");
    var mostrar = pronto ? Math.min(Math.max(Math.round(total),1), MAX_CELLS) : IDLE_CELLS;
    while (g.children.length > mostrar) g.removeChild(g.lastChild);
    while (g.children.length < mostrar){
      var d = document.createElement("div"); d.className = "slot"; g.appendChild(d);
    }
    if (!pronto){
      for (var j=0;j<g.children.length;j++) g.children[j].className = "slot idle";
      g.setAttribute("aria-label","Grade dos horários do período. Ainda sem dados preenchidos.");
      return;
    }
    var alvo = Math.round(perdidas * (mostrar/total));
    var passo = alvo > 0 ? mostrar/alvo : 0;
    var marcados = {};
    for (var k=0;k<alvo;k++) marcados[Math.floor(k*passo)] = true;
    for (var i=0;i<g.children.length;i++) g.children[i].className = marcados[i] ? "slot lost" : "slot";
    g.setAttribute("aria-label","Grade dos horários do período: " + Math.round(perdidas) + " de " + Math.round(total) + " ficaram vazios.");
  }

  function calcular(){
    var vTicket = lido("ticket"), vAgend = lido("agendados"),
        vCancel = lido("cancel") || 0, vNoshow = lido("noshow") || 0,
        vRecup  = lido("recuperadas") || 0, vDur = lido("duracao");

    erro("errRisco", null, "");
    erro("errRecuperadas", C.recuperadas.n, "");

    var emRisco = vCancel + vNoshow;

    if (vAgend !== null && emRisco > vAgend){
      erro("errRisco", null, "Desmarcações e faltas somadas passaram do total de atendimentos marcados. Confira os números.");
    }
    if (emRisco > 0 && vRecup > emRisco){
      erro("errRecuperadas", C.recuperadas.n, "Não dá para recuperar mais horários do que os " + emRisco + " que abriram.");
      vRecup = emRisco;
    }

    var pronto = vTicket > 0 && vAgend > 0 && emRisco <= vAgend;

    if (!pronto){
      $("anual").textContent = "—"; $("anual").classList.add("idle");
      $("mensal").textContent = "—"; $("horas").textContent = "—";
      $("anualNote").textContent = "Projeção anual a partir dos seus últimos 30 dias.";
      $("agendaCount").textContent = "arraste para começar";
      $("agendaCount").classList.add("idle");
      grade(0,0,false);
      return;
    }

    var recupEfetivas = Math.min(vRecup, emRisco);
    var perdidas = Math.max(0, emRisco - recupEfetivas);
    var perdaMes = perdidas * vTicket;
    var perdaAno = perdaMes * 12;
    var horasAno = vDur ? perdidas * (vDur/60) * 12 : null;
    var taxa     = perdidas / vAgend * 100;

    $("anual").textContent = brl(perdaAno);
    $("anual").classList.remove("idle");
    $("mensal").textContent = brl(perdaMes);
    $("horas").textContent = horasAno === null
      ? Math.round(perdidas*12).toLocaleString("pt-BR") + " horários"
      : Math.round(horasAno).toLocaleString("pt-BR") + " h";
    $("anualNote").textContent = perdidas > 0
      ? "Equivale à receita média de " + Math.round(perdaAno/vTicket).toLocaleString("pt-BR") + " atendimentos."
      : "Tudo que abriu foi preenchido. Raro — e vale proteger para continuar assim.";
    $("agendaCount").textContent = Math.round(perdidas) + " de " + Math.round(vAgend) + " · " + taxa.toFixed(0) + "% vazios";
    $("agendaCount").classList.toggle("idle", perdidas === 0);

    grade(vAgend, perdidas, true);

    C.ticket.h.value = vTicket; C.agendados.h.value = vAgend;
    C.cancel.h.value = vCancel; C.noshow.h.value = vNoshow;
    C.recuperadas.h.value = recupEfetivas;
    C.duracao.h.value = vDur === null ? "" : vDur;
    $("h_perdidas").value = perdidas;
    $("h_perdaMes").value = Math.round(perdaMes);
    $("h_perdaAno").value = Math.round(perdaAno);
    $("h_perdaAnoTxt").value = brl(perdaAno);
    $("h_perdaMesTxt").value = brl(perdaMes);
    $("h_horas").value = horasAno === null ? "" : Math.round(horasAno);
    $("h_taxa").value = taxa.toFixed(1);
    $("h_tocados").value = chaves.filter(function(k){ return C[k].tocado; }).join(",");

    marcar("calculo_concluido");
  }

  (function(){
    var p = new URLSearchParams(window.location.search);
    $("h_utmSource").value   = p.get("utm_source")   || "";
    $("h_utmMedium").value   = p.get("utm_medium")   || "";
    $("h_utmCampaign").value = p.get("utm_campaign") || "";
  })();

  var jaMarcados = {};
  function marcar(evento){
    if (jaMarcados[evento]) return;
    jaMarcados[evento] = true;
    window.dataLayer = window.dataLayer || [];
    window.dataLayer.push({ event: "calc_" + evento });
  }

  var form = $("form"), botao = $("enviar");
  function emailValido(v){ return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$/.test(v); }

  form.addEventListener("submit", function(e){
    e.preventDefault();
    erro("errEmail", $("email"), "");
    erro("errForm", null, "");
    if ($("empresa_site").value) return;
    if (!emailValido($("email").value.trim())){
      erro("errEmail", $("email"), "Confira o e-mail — parece que falta alguma coisa.");
      $("email").focus(); return;
    }
    if ($("anual").classList.contains("idle")){
      erro("errForm", null, "Ajuste pelo menos o valor por atendimento e os atendimentos marcados, para eu ter o que te mandar.");
      C.ticket.r.focus(); return;
    }
    if (!BREVO_FORM_ACTION){
      erro("errForm", null, "Formulário ainda não conectado à Brevo. Preencha BREVO_FORM_ACTION no arquivo antes de publicar.");
      return;
    }
    marcar("email_enviado");
    botao.disabled = true; botao.textContent = "Enviando...";
    form.target = "brevo-submit-frame";
    form.action = BREVO_FORM_ACTION;
    form.submit();

    var destino = new URLSearchParams();
    destino.set("nome", $("nome").value.trim());
    destino.set("perdaAnoTxt", $("h_perdaAnoTxt").value);
    destino.set("perdaMesTxt", $("h_perdaMesTxt").value);
    destino.set("horas", $("h_horas").value);
    destino.set("perdidas", $("h_perdidas").value);
    destino.set("agendados", $("h_agendados").value);
    destino.set("taxa", $("h_taxa").value);
    var origem = new URLSearchParams(window.location.search);
    ["utm_source","utm_medium","utm_campaign","utm_content","utm_term"].forEach(function(key){
      if (origem.get(key)) destino.set(key, origem.get(key));
    });
    setTimeout(function(){
      window.location.href = "/calculadora-agenda-vazia/obrigado/?" + destino.toString();
    }, 350);
  });

  calcular();
})();
`}></script>
